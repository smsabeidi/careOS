# Copy to .env.local for local dev (never commit real values — .env* is gitignored).
# supabase start prints the local URL + anon key; see `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Demo mode — enables the "View as" persona switcher and auto MFA step-up for the
# seeded synthetic accounts (they reach real AAL2, no bypass). It can only impersonate
# those synthetic accounts. NEVER set CAREOS_DEMO_MODE on a deployment holding real PHI.
CAREOS_DEMO_MODE=true
NEXT_PUBLIC_CAREOS_DEMO_MODE=true
CAREOS_DEMO_PASSWORD=Meadowbrook!demo1

# AI plane (optional). With no key the Brain uses a deterministic mock; with a key it
# calls OpenAI. Real PHI to any LLM requires a signed BAA first (synthetic only until then).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
