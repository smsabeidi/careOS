{
  "name": "@careos/web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:list": "playwright test --list",
    "e2e:ui": "playwright test --ui",
    "e2e:a11y": "playwright test e2e/specs/a11y",
    "e2e:report": "playwright show-report e2e/.artifacts/html-report",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^3",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3"
  }
}
